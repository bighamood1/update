# Copy this file to `.env` and adjust values as needed.

# --- Ollama / LLM ---
OLLAMA_BASE_URL=http://localhost:11434
# Leave empty for automatic selection: the first INSTALLED model from
# OLLAMA_PREFERRED_MODELS is used (never auto-downloaded). On this CPU-only
# machine qwen3:4b / qwen3:1.7b are dramatically faster than qwen3-vl:8b.
# Pull one with `ollama pull qwen3:4b` and set OLLAMA_MODEL=qwen3:4b.
# An explicit value that is NOT installed fails startup with a clear error.
OLLAMA_MODEL=
OLLAMA_PREFERRED_MODELS=qwen3:4b,qwen3:1.7b,qwen3:8b,qwen3:0.6b,qwen3-vl:8b
OLLAMA_TIMEOUT=600
OLLAMA_TEMPERATURE=0.1
OLLAMA_TOP_P=0.9
OLLAMA_NUM_CTX=8192
# Generation budget. Conservative default (2500) because qwen3-vl:8b can emit
# a large thinking block even with think=false; a tiny cap truncates the
# visible answer to empty. Raw override: OLLAMA_NUM_PREDICT.
OLLAMA_MAX_OUTPUT_TOKENS=2500
# Seconds the model stays resident between requests (avoids cold-start reloads).
OLLAMA_KEEP_ALIVE=30m
# Pin the embedding/reranker torch thread pool (0 = framework default). On the
# shared i7-1165G7 (4 cores / 8 threads) a fixed count avoids oversubscription.
CPU_THREADS=0

# --- Data / paths ---
DATA_PATH=data/documents.jsonl
VECTOR_DB_PATH=vectorstore
LOGS_DIR=logs

# --- Chunking ---
CHUNK_SIZE=800
CHUNK_OVERLAP=100
MIN_CHUNK_CHARS=40

# --- Embeddings ---
# e5-small: 384 dims, ~470MB, strong Arabic+English retrieval (recommended).
# Alternatives: paraphrase-multilingual-MiniLM-L12-v2 (118MB, faster, weaker).
EMBEDDING_MODEL=intfloat/multilingual-e5-small
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=32
EMBEDDING_NORMALIZE=true
EMBEDDING_QUERY_PREFIX=query: 
EMBEDDING_PASSAGE_PREFIX=passage:

# --- Retrieval ---
TOP_K=8
# Alias: RETRIEVAL_TOP_K (same setting).
SIMILARITY_THRESHOLD=0.25
# Candidate pool that reaches the reranker / final pass.
RERANK_CANDIDATES=20
# Hybrid dense + BM25 lexical retrieval (RRF fusion). Turn off to use dense only.
HYBRID_ENABLED=true
# Fusion mode: rrf (default, robust) or linear (uses DENSE_WEIGHT/BM25_WEIGHT).
HYBRID_FUSION=rrf
DENSE_WEIGHT=0.65
BM25_WEIGHT=0.35
RRF_K=60
# Local query normalization + intent-aware keyword expansion (no LLM).
QUERY_EXPANSION_ENABLED=true
MAX_QUERY_EXPANSION_TERMS=8
# Context actually sent to the LLM (chunks / characters).
FINAL_CONTEXT_CHUNKS=4
CONTEXT_MAX_CHARS=4000
# Hard cap on how many chunks may reach the LLM (dedup + source diversity
# happen in the retriever first; simple intents use fewer via
# INTENT_CONTEXT_CHUNKS). Lowering this speeds generation on CPU.
TOP_CONTEXT_CHUNKS=6
# --- Deterministic routing / metadata-first retrieval ---
ROUTER_ENABLED=true
ROUTER_CONFIDENCE_THRESHOLD=0.80
ROUTER_MIN_RESULTS=3
ROUTER_FALLBACK_ENABLED=true
ROUTER_FILTER_LANGUAGE=true
ROUTER_FILTER_CATEGORY=true
ROUTER_FILTER_FACULTY=true
# --- Dynamic top-k (final chunks vary by question complexity) ---
DYNAMIC_TOP_K_ENABLED=true
TOP_K_FACT=4
TOP_K_LIST=6
TOP_K_COMPLEX=8
# --- Intent-aware context sizing (chunks sent to the LLM per intent) ---
# Simple facts use fewer chunks => faster generation; lists/complex use more.
INTENT_CONTEXT_CHUNKS=fact:3,location:3,contact:3,tuition:3,person:3,faq:3,news:4,facility:4,scholarship:4,unknown:4,admission:5,regulation:5,administration:5,faculty:6,program:6,list:6,comparison:6
# Deterministic fast answers (location / faculties list / contact info) built
# from authoritative indexed sources, bypassing the LLM entirely.
FAST_PATH_ENABLED=true
# Fast answers only when the deterministic router is at least this confident
# (default 0.55 > the weak-signal 0.53 level, so e.g. FACULTY at 0.53 never
# auto-answers). The authoritative-chunk requirement still applies on top.
FAST_PATH_MIN_CONFIDENCE=0.55
# --- Resource limits ---
MAX_RETRIEVAL_RESULTS=30
MAX_RERANK_RESULTS=20
MAX_CONTEXT_CHUNKS=6
MAX_CONTEXT_TOKENS=4096
MAX_GENERATION_TOKENS=2500
# --- Caching (embedding + retrieval, LRU + TTL) ---
CACHE_ENABLED=true
CACHE_EMBEDDING_SIZE=512
CACHE_RETRIEVAL_SIZE=256
CACHE_RETRIEVAL_TTL=3600
# Reranker is enabled by default for production precision. It is slow to load
# on CPU (~1.1GB cross-encoder); set RERANKER_ENABLED=false for low-resource
# local smoke tests.
# bge-reranker-base supports both Arabic and English; ms-marco is English-only.
# Alias: ENABLE_RERANKER (same setting).
RERANKER_ENABLED=true
RERANKER_MODEL=BAAI/bge-reranker-base
RERANK_TOP_K=8
# Cross-encoder device + batch size (CPU tuning; smaller batch = lower peak RAM).
RERANKER_DEVICE=cpu
RERANKER_BATCH_SIZE=32

# --- Index build ---
CHROMA_COLLECTION=nmu_documents
FORCE_REBUILD=false

# --- Misc ---
LOG_LEVEL=INFO

# --- Query understanding (Phase 1: deterministic routing + normalization) ---
QUERY_UNDERSTANDING_ENABLED=true
# Bounded lexical variants for BM25 on ambiguous / multi-intent questions.
MAX_RETRIEVAL_VARIANTS=3

# --- Multi-intent handling (Phase 3) ---
MULTI_INTENT_ENABLED=true
MULTI_INTENT_CONFIDENCE=0.80

# --- Adaptive candidate pool (Phase 6) ---
ADAPTIVE_RETRIEVAL_ENABLED=true
ADAPTIVE_NARROW_FACTOR=0.80
ADAPTIVE_MULTI_FACTOR=0.60
ADAPTIVE_MIN_CANDIDATES=10

# --- Retrieval memory (Phase 14: soft historical source hints) ---
RETRIEVAL_MEMORY_ENABLED=true
# How many historical source URLs may be seeded into the candidate pool as
# soft hints (always re-ranked; fallback retrieval is preserved).
MEMORY_SEED_URLS=2

# --- Semantic response cache (Phase 5) ---
# A cached answer is returned ONLY when similarity + intent + kb_version
# + quality gates all pass; uncertainty/staleness always rerun full RAG.
# Intent must match EXACTLY (a generic/uncertain intent never reuses a cached
# answer for a different intent), and generic intents need the stricter
# CACHE_GENERIC_SIMILARITY_THRESHOLD because the entity name alone can push
# semantically different questions above the normal threshold.
CACHE_SIMILARITY_THRESHOLD=0.92
CACHE_GENERIC_SIMILARITY_THRESHOLD=0.97
CACHE_MIN_QUALITY_SCORE=0.5
CACHE_MAX_ENTRIES=2000

# --- Feedback + analytics (Phase 12) ---
FEEDBACK_ENABLED=true
FEEDBACK_REASONS_ENABLED=true

# --- Quality validation (Phase 16, soft; hard grounding is always on) ---
QUALITY_VALIDATION_ENABLED=true
ANSWER_MAX_CHARS=4000

# --- Runtime SQLite store (question events, feedback, cache, memory) ---
RUNTIME_DB_PATH=data/runtime/nmu_runtime.db

# --- Concurrency (Phase 26): parallel Ollama generations allowed ---
# Keep 1 on this CPU-only machine; raise only on stronger hardware.
MAX_CONCURRENT_GENERATIONS=1
